#include <iostream>
#include <vector>

using namespace std;

void printStudentInfo() {
    cout << "Студент: Иванов Иван" << endl;
    cout << "Группа: ПИ-231" << endl;
    cout << "Задача: 1" << endl;
    cout << endl;
}

void printMatrix(const vector<vector<int>>& matrix) {
    for (const auto& row : matrix) {
        for (const auto& element : row) {
            cout << element << "\t";
        }
        cout << endl;
    }
}

int main() {
    printStudentInfo();
    
    // Пример матрицы для демонстрации
    vector<vector<int>> matrix = {
        {1, 2, 3},
        {4, 5, 6},
        {7, 8, 9}
    };
    
    cout << "Содержимое матрицы:" << endl;
    printMatrix(matrix);
    
    return 0;
}